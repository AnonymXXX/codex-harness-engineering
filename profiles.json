{
  "version": 1,
  "distribution": {
    "name": "codex-harness-engineering",
    "repository": "AnonymXXX/codex-harness-engineering"
  },
  "global_links": [
    {
      "source": ".codex/AGENTS.md",
      "destination": ".codex/AGENTS.md"
    },
    {
      "source": ".codex/RTK.md",
      "destination": ".codex/RTK.md"
    },
    {
      "source": ".codex/docs/workflows",
      "destination": ".codex/docs/workflows"
    }
  ],
  "profiles": {
    "core": {
      "description": "Global Harness rules, workflows, and five core engineering skills.",
      "includes": []
    },
    "daily": {
      "description": "Core Harness plus frequently used portable engineering skills.",
      "includes": [
        "core"
      ]
    }
  },
  "dependency_checks": [
    {
      "id": "git",
      "profile": "core",
      "kind": "command",
      "value": "git",
      "missing": "action-required"
    },
    {
      "id": "python3",
      "profile": "core",
      "kind": "command",
      "value": "python3",
      "missing": "action-required"
    },
    {
      "id": "node",
      "profile": "daily",
      "kind": "command",
      "value": "node",
      "missing": "action-required"
    },
    {
      "id": "curl",
      "profile": "daily",
      "kind": "command",
      "value": "curl",
      "missing": "action-required"
    },
    {
      "id": "github-auth",
      "profile": "daily",
      "kind": "gh-auth",
      "value": "gh",
      "missing": "action-required"
    },
    {
      "id": "browser",
      "profile": "daily",
      "kind": "path-any",
      "values": [
        "/Applications/Google Chrome.app",
        "/Applications/Microsoft Edge.app"
      ],
      "missing": "action-required"
    },
    {
      "id": "wechat-devtools",
      "profile": "daily",
      "kind": "path-any",
      "values": [
        "/Applications/wechatwebdevtools.app"
      ],
      "missing": "optional"
    }
  ],
  "skills": {
    "codebase-design": {
      "profile": "core",
      "description": "Design deep modules, clean interfaces, adapters, and test seams.",
      "dependencies": [],
      "credentials": "none",
      "validation": "SKILL.md metadata validation"
    },
    "diagnosing-bugs": {
      "profile": "core",
      "description": "Diagnose difficult bugs and regressions through reproducible evidence.",
      "dependencies": [],
      "credentials": "none",
      "validation": "SKILL.md metadata validation"
    },
    "domain-modeling": {
      "profile": "core",
      "description": "Capture durable domain language, invariants, rules, and decisions.",
      "dependencies": [],
      "credentials": "none",
      "validation": "SKILL.md metadata validation"
    },
    "harness-engineering": {
      "profile": "core",
      "description": "Apply the global risk, worktree, documentation, and validation workflow.",
      "dependencies": [
        "git",
        "python3"
      ],
      "credentials": "none",
      "validation": "python3 ~/.agents/skills/harness-engineering/scripts/harness_doctor.py doctor"
    },
    "tdd": {
      "profile": "core",
      "description": "Implement concrete behavior through a red-green feedback loop.",
      "dependencies": [],
      "credentials": "none",
      "validation": "SKILL.md metadata validation"
    },
    "web-access": {
      "profile": "daily",
      "description": "Perform network research and browser/CDP workflows.",
      "dependencies": [
        "node",
        "curl",
        "Chrome or Edge"
      ],
      "credentials": "Local browser session and ignored config.env preference",
      "validation": "node ~/.agents/skills/web-access/scripts/check-deps.mjs"
    },
    "git-auto-commit": {
      "profile": "daily",
      "description": "Group and commit local Git changes conservatively.",
      "dependencies": [
        "git"
      ],
      "credentials": "none",
      "validation": "SKILL.md metadata validation"
    },
    "github-cli-ops": {
      "profile": "daily",
      "description": "Operate GitHub platform workflows through gh and Git.",
      "dependencies": [
        "git",
        "gh"
      ],
      "credentials": "gh auth login",
      "validation": "gh auth status"
    },
    "release-ops": {
      "profile": "daily",
      "description": "Inspect and promote release commits, tags, and branches.",
      "dependencies": [
        "git",
        "python3"
      ],
      "credentials": "Repository remote authentication",
      "validation": "python3 syntax and unit validation"
    },
    "frontend-design": {
      "profile": "daily",
      "description": "Guide intentional visual direction and frontend design decisions.",
      "dependencies": [],
      "credentials": "none",
      "validation": "SKILL.md metadata validation"
    },
    "develop-uniapp-miniapp": {
      "profile": "daily",
      "description": "Build and extend uni-app WeChat mini-program projects.",
      "dependencies": [
        "Project-selected Node.js package manager"
      ],
      "credentials": "Project-specific only",
      "validation": "SKILL.md metadata validation"
    },
    "wechat-miniprogram-ci-upload": {
      "profile": "daily",
      "description": "Upload WeChat Mini Program builds through DevTools CLI or miniprogram-ci.",
      "dependencies": [
        "node",
        "WeChat DevTools"
      ],
      "credentials": "DevTools login or project-local ignored upload key",
      "validation": "Dependency and target-project preflight"
    }
  }
}
